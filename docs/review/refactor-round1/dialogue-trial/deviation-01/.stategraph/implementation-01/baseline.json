          "U02",
          "U03"
        ],
        "asked_in": [
          "A02"
        ],
        "resolution": {
          "kind": "user_answer",
          "text": "撤销审批或撤销审批人对该机的权限后重新判断全部可用审批；任一有效则继续，否则保留队列位置等待。恢复后自动继续，后续有资格任务可越过暂时无资格任务，按原入队顺序选择。打印已开始后不因审批变化停止。",
          "source_refs": [
            "U03"
          ]
        }

    "static/graph/replay-steps.js",
    "static/graph/runtime-frames.js",
    "static/graph/viewer.css",
    "static/graph/viewer.js",
    "tooling/__init__.py",
    "tooling/behavior_source.json",
    "tooling/build_model.py",
    "tooling/frontend_cases.mjs",
    "tooling/frontend_nodes.json",
    "tooling/graph_tests.mjs",
    "tooling/mutations.py",
    "tooling/observe.py",
    "tooling/scenarios.py",
    "tooling/size_scenarios.py",
    "tooling/test_recorded_views.mjs",
    "tooling/test_recording.py",
    "tooling/test_stategraph_module.py",
    "tooling/tests.py",
    "validate.py"
  ],
  "acceptance": "acceptance.json",
  "discovery": "discovery.json",
  "whitebox": "whitebox.json",
  "slice_depth": 1,
  "probe_callees": [
    "trace.bo_record"
  ],
  "required_probes": [
    {
      "node": "scope_check",
      "phase": "decision"
    },
    {
      "node": "approval_candidate",
      "phase": "decision"
    },
    {
      "node": "archive_commit",
      "phase": "commit"
    },
    {
      "node": "project_limit",
      "phase": "read"
    },
    {
      "node": "size_guard",
      "phase": "decision"
    }
  ],
  "required_runtime_probes": [
    {
      "case": "archive_snapshot",
      "node": "archive_commit",
      "phase": "commit"
    },
    {
      "case": "secret_content",
      "node": "content_check",
      "phase": "return"
    },
    {
      "case": "size_commit_fresh",
      "node": "size_guard",
      "phase": "decision"
    }
  ],
  "probe_modes": [
    "on",
    "off",
    "fault"
  ],
  "required_execution_cases": [
    "capacity_one",
    "capacity_two",
    "edit_overlap",
    "cancel_running",
    "loss_and_resume",
    "join_pending",
    "size_running_restore",
    "size_commit_fresh"
  ],
  "observations_command": [
    "{python}",
    "-X",
    "utf8",
    "-B",
    "tooling/observe.py"
  ],
  "test_commands": [
    [
      "{python}",
      "-X",
      "utf8",
      "-B",
      "tooling/tests.py"
    ],
    [
      "node",
      "tooling/graph_tests.mjs"
    ],
    [
      "{python}",
      "-X",
      "utf8",
      "-B",
      "tooling/test_recording.py"
    ],
    [
      "node",
      "tooling/test_recorded_views.mjs"
    ],
    [
      "{python}",
      "-X",
      "utf8",
      "-B",
      "tooling/test_stategraph_module.py"
    ]
  ],
  "timeout_seconds": 120,
  "stategraph": {
    "module": "bo_stategraph/__init__.py",
    "development_mode": "drive",
    "execution_mode": "drive",
    "decision_source": "user",
    "decision": "\u5408\u6210\u793a\u4f8b\u7684\u6a21\u62df\u9700\u6c42\u65b9\u9009\u62e9\uff1a\u7ee7\u7eed\u57fa\u4e8e\u72b6\u6001\u56fe\u9a71\u52a8\u5f00\u53d1\uff1b\u4e24\u79cd\u6a21\u5f0f\u5747\u4fdd\u7559\u76d1\u63a7\u53ca\u6620\u5c04\u68c0\u67e5\u3002"
  },
  "source_scope": {
    "roots": [
      "."
    ],
    "require_symbol_classification": true,
    "exclude": {
      "review/**": "Frozen test evidence from earlier versions; not loaded by the program.",
      "history/**": "Earlier graph and implementation evidence.",
      "scratch/**": "Local generated run data.",
      "observer_generated/__init__.py": "Package marker only; copied source inventory covers its runtime.",
      "observer_runtime/**": "Shared tool implementation; copied-source integrity and tool tests cover it.",
      "tooling/**": "Project generation and test commands; separately watched and executed.",
      "tests/**": "Scenario runners and assertions, not business implementation.",
      "integrations/**": "Observation and HTTP wiring; architecture/import and HTTP checks cover it.",
      "run.py": "Server startup; watched and exercised by HTTP tests.",
      "main.py": "Business core startup; exercised from the exported package.",
      "validate.py": "Validation entry point; runs the project gate.",
      "bo_stategraph/__init__.py": "Shared query implementation; copy integrity and module tests cover it.",
      "bo_stategraph/bo_contracts.py": "Shared contract implementation; parity regression tests cover it.",
      "bo_stategraph/execution_contract.py": "Shared activity contract; resource and concurrency tests cover it.",
      "bo_stategraph/query.py": "Projection adapter; actual SQLite-to-instance witnesses cover it.",
      "archive_app/workflow.py": "Compatibility import only; executable definition lives in bo_stategraph/workflow.py.",
      "observer_generated/static/**": "Reviewed graph viewer assets; runtime manifest checks their exact bytes.",
      "static/graph/**": "Reviewed graph viewer assets; runtime manifest checks their exact bytes."
    },
    "frozen_sources": {
      "review/v1/source-snapshot": "review/v1/manifest.json",
      "review/v2/source-snapshot": "review/v2/manifest.json"
    }
  },
  "require_mapping_witnesses": true,
  "mapping_contract": "mapping.json",
  "view_preferences_legacy_ids": [
    "team-archive-example"
  ]
}

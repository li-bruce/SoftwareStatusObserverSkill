  "decisions": [
    {"id": "D01", "topic": "authority", "question": "负责人管理“项目A”时，是否也能处理所有下级文件夹？如果某个下级文件夹另设负责人，上级负责人是否仍有权限？", "why": "决定目录继承、管理范围计算及越权反例。", "affects": ["scope_check", "document_scope", "scope_archive"], "blocking": true, "status": "open", "priority": 1, "source_refs": ["U01"], "asked_in": ["A01"]},
    {"id": "D02", "topic": "authority", "question": "审批针对什么对象：一份资料、这份资料的某个内容版本，还是一个文件夹及其下级资料？", "why": "决定审批检索、目录覆盖与内容改版后能否沿用审批。", "affects": ["approval_check", "approval_archive", "edit_approval"], "blocking": true, "status": "open", "priority": 1, "source_refs": ["U01"], "asked_in": ["A01"]},
    {"id": "D03", "topic": "completion", "question": "归档成功后应实际保存什么：只记录“已归档”，保存当时内容的固定快照，还是移动或复制文件到归档目录？", "why": "决定实际提交效果、重复归档行为与权威效果验证目标。", "affects": ["archive_commit"], "blocking": true, "status": "open", "priority": 1, "source_refs": ["U01", "I01"], "asked_in": ["A01"]},
    {"id": "D04", "topic": "resources", "question": "两项检查是否可并行，名额在什么范围共享，每项检查何时占用和归还名额？", "why": "决定活动实例、资源守恒、排队与真实重叠的验证。", "affects": ["content_check", "index_check", "processing_slots", "slots_content", "slots_index"], "blocking": true, "status": "open", "priority": 2, "source_refs": ["U01"], "depends_on": ["D03"]},
    {"id": "D05", "topic": "authority", "question": "谁可以审批；同一资料有多条审批时，需要全部有效，还是任一条有效就可继续？", "why": "决定审批者规则、候选逐条求值及汇总条件。", "affects": ["approval_check", "approval_archive"], "blocking": true, "status": "open", "priority": 2, "source_refs": ["U01"], "depends_on": ["D02"]},
    {"id": "D06", "topic": "consistency", "question": "排队或检查期间撤销审批、修改资料内容时，旧检查应如何结束；原审批和结果还能用于归档吗？", "why": "决定版本隔离、取消与实际停止、结果有效性和提交复核。", "affects": ["approval_revoked", "content_changed", "approval_check", "content_check", "index_check", "archive_commit"], "blocking": true, "status": "open", "priority": 2, "source_refs": ["U01"], "depends_on": ["D02", "D03"]},
    {"id": "D07", "topic": "completion", "question": "内容检查和索引检查各自检验什么，失败后是否阻止归档，怎样重新处理？", "why": "没有明确的通过标准就不能建立独立业务验收。", "affects": ["content_check", "index_check", "content_archive", "index_archive"], "blocking": true, "status": "open", "priority": 3, "source_refs": ["U01"], "depends_on": ["D03"]},
    {"id": "D08", "topic": "concurrency", "question": "检查是否必须等审批后才开始；名额或审批条件恢复后自动继续，还是由负责人再次发起？", "why": "决定流程启动门槛、等待条件及恢复触发。", "affects": ["archive_request", "approval_check", "content_check", "index_check", "processing_slots"], "blocking": true, "status": "open", "priority": 3, "source_refs": ["U01"], "depends_on": ["D02", "D04"]}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/database-config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "bo-databases/v1"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "engine": {
            "enum": [
              "sqlalchemy",
              "mongodb",
              "redis",
              "neo4j"
            ]
          },
          "url_env": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "const": "user"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "source",
              "answer",
              "locator"
            ]
          },
          "model_layer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "declaration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "key_patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true
          },
          "sample_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "scan_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "label",
          "engine",
          "url_env",
          "selection",
          "model_layer",
          "source_files"
        ]
      },
      "minItems": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "path",
              "symbol"
            ]
          },
          "store": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "action": {
            "enum": [
              "read",
              "write",
              "transaction",
              "transform"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true
          },
          "target_actions": {
            "type": "object",
            "additionalProperties": {
              "enum": ["read", "write", "read_write"]
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/capture"
            }
          },
          "before": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/capture"
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/capture"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true
          },
          "required_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "failure_cases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "label",
          "parent",
          "source",
          "store",
          "action",
          "targets",
          "parameters",
          "before",
          "after",
          "required_cases"
        ]
      },
      "minItems": 1
    },
    "exporters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "store": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 1
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "store",
          "command",
          "output"
        ]
      }
    }
  },
  "required": [
    "protocol",
    "stores",
    "operations"
  ],
  "$defs": {
    "capture": {
      "oneOf": [
        {
          "enum": [
            "string",
            "number",
            "boolean",
            "scalar"
          ]
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/capture"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/capture"
          }
        }
      ]
    }
  }
}

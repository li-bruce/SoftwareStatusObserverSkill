{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Observer event v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "seq", "build_id", "model_revision", "request_id", "attempt_id", "tx_id", "entity_id", "node_id", "observed_at", "kind", "payload"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "event_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 1}, "build_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1},
    "tx_id": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["fact", "decision", "transition", "effect"]},
    "payload": {"type": "object", "additionalProperties": false, "properties": {
      "value": {"type": ["string", "number", "boolean", "null", "array"], "items": {"type": ["string", "number", "boolean", "null"]}},
      "source": {"type": "string"}, "version": {"type": "integer", "minimum": 0},
      "quality": {"type": "string", "enum": ["committed", "cache", "intermediate", "inferred", "unknown"]},
      "valid_until": {"type": ["number", "null"]},
      "status": {"type": "string", "enum": ["true", "false", "unknown", "stale"]},
      "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}},
      "basis_version": {"type": "integer", "minimum": 0},
      "from_state": {"type": "string"}, "to_state": {"type": "string"},
      "outcome": {"type": "string"}, "effect_id": {"type": "string"}
    }}
  }
}

{
  "model": "behavior.json",
  "manifest": "manifest.json",
  "code_files": ["domain.py", "workflow.py", "store.py"],
  "watch_files": ["observe.py", "build_model.py", "test_workflow.py"],
  "acceptance": "acceptance.json",
  "slice_depth": 1,
  "probe_callees": ["trace.record"],
  "required_probes": [
    {"symbol": "domain.py::Lab.execute", "node": "estimate", "phase": "return"},
    {"symbol": "domain.py::Lab.commit_result", "node": "commit", "phase": "commit"}
  ],
  "required_runtime_probes": [{"case": "normal", "node": "commit", "phase": "commit"}],
  "probe_modes": ["on", "off", "fault"],
  "observations_command": ["python", "-B", "-X", "utf8", "observe.py"],
  "test_commands": [["python", "-B", "test_workflow.py"]],
  "timeout_seconds": 120
}

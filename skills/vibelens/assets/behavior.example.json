  "nodes": [
    {
      "id": "read",
      "kind": "action",
      "label": "Read task",
      "summary": "Read task and artifact from the same SQLite snapshot. An existing same-version artifact returns already_committed; subsequent computation and new commit are skipped.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.read_job"
      },
      "capture": {
        "in": {
          "job_id": "string"
        },
        "out": {
          "outcome": "string",
          "effect_id": "string",
          "tx_id": "string",
          "cells": "number",
          "steps": "number",
          "priority": "string",
          "param_version": "number",
          "state": "string"
        }
      },
      "requirements": [
        "R1",
        "R5"
      ]
    },
    {
      "id": "estimate",
      "kind": "function",
      "label": "Calculate budget",
      "summary": "Propagate cells × steps × priority weight into required quota.",
      "source": {
        "path": "domain.py",
        "symbol": "estimate_cost"
      },
      "capture": {
        "in": {
          "cells": "number",
          "steps": "number",
          "priority": "string",
          "param_version": "number"
        },
        "out": {
          "weight": "number",
          "units": "number"
        }
      },
      "requirements": [
        "R4"
      ],
      "predicate": "ceil(cells × steps × weight / 1000)"
    },
    {
      "id": "authorize",
      "kind": "decision",
      "label": "Check execution permission",
      "summary": "The actor is an engineer in the project, and at least one approval meets every condition. Reevaluate candidates on each check.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.authorize"
      },
      "capture": {
        "in": {
          "units": "number",
          "param_version": "number",
          "clock": "number",
          "stage": "string"
        },
        "out": {
          "allowed": "boolean",
          "eligible": [
            "string"
          ],
          "reasons": [
            "string"
          ]
        }
      },
      "requirements": [
        "R2",
        "R3",
        "R5"
      ],
      "predicate": "member_allowed AND any(grant_matches)",
      "candidate_table": {
        "node": "match",
        "title": "Per approval: all conditions; across candidates: any valid approval",
        "id_field": "id",
        "columns": [
          {
            "field": "scope_ok",
            "label": "Scope"
          },
          {
            "field": "version_ok",
            "label": "Version"
          },
          {
            "field": "time_ok",
            "label": "Expiry"
          },
          {
            "field": "budget_ok",
            "label": "Quota"
          },
          {
            "field": "active_ok",
            "label": "Not revoked"
          },
          {
            "field": "eligible",
            "label": "Valid"
          }
        ]
      }
    },
    {
      "id": "access",
      "kind": "function",
      "label": "Read relations and approvals",
      "summary": "Read authoritative relations and candidate approvals, without reusing historical allow results.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.read_access"
      },
      "capture": {
        "in": {
          "actor": "string",
          "project": "string"
        },
        "out": {
          "role": "string",
          "member_project": "string",
          "grants": [
            {
              "id": "string",
              "project": "string",
              "actor": "string",
              "param_version": "number",
              "limit_units": "number",
              "expires": "number",
              "revoked": "boolean"
            }
          ]
        }
      },
      "parent": "authorize"
    },
    {
      "id": "member",
      "kind": "decision",
      "label": "Project membership",
      "summary": "The actor belongs to the task project and has the engineer role.",
      "source": {
        "path": "domain.py",
        "symbol": "member_allowed"
      },
      "capture": {
        "in": {
          "role": "string",
          "member_project": "string",
          "job_project": "string"
        },
        "out": {
          "allowed": "boolean"
        }
      },
      "parent": "authorize",
      "predicate": "role == engineer AND member_project == job_project"
    },
    {
      "id": "match",
      "kind": "decision",
      "label": "Match each approval",
      "summary": "One approval must satisfy scope, version, expiry, quota, and nonrevocation together.",
      "source": {
        "path": "domain.py",
        "symbol": "grant_matches"
      },
      "capture": {
        "in": {
          "id": "string",
          "project": "string",
          "actor": "string",
          "param_version": "number",
          "limit_units": "number",
          "expires": "number",
          "revoked": "boolean",
          "job_project": "string",
          "job_actor": "string",
          "job_version": "number",
          "units": "number",
          "clock": "number"
        },
        "out": {
          "id": "string",
          "scope_ok": "boolean",
          "version_ok": "boolean",
          "time_ok": "boolean",
          "budget_ok": "boolean",
          "active_ok": "boolean",
          "eligible": "boolean"
        }
      },
      "parent": "authorize",
      "requirements": [
        "R2",
        "R3"
      ],
      "predicate": "scope_ok AND version_ok AND time_ok AND budget_ok AND active_ok",
      "aggregate": {
        "id_field": "id",
        "result_field": "eligible",
        "label": "eligible",
        "input_field": "units"
      }
    },
    {
      "id": "wait",
      "kind": "wait",
      "label": "Wait / retry",
      "summary": "Save the failure reason. After conditions change, execution rereads parameters and reevaluates.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.wait"
      },
      "capture": {
        "in": {
          "reasons": [
            "string"
          ],
          "previous_state": "string"
        },
        "out": {
          "state": "string",
          "resume": "string"
        }
      },
      "resume": "Update approval or membership for the parameters, then explicitly rerun. No automatic execution.",
      "inspect_target": "authorize",
      "reason_labels": {
        "member_required": "The actor must belong to the current project and be an engineer",
        "no_matching_approval": "No nonrevoked approval satisfies scope, version, expiry, and quota together",
        "parameters_changed_during_compute": "Parameters changed during computation; obtain matching approval and recompute"
      }
    },
    {
      "id": "solve",
      "kind": "action",
      "label": "Run computation",
      "summary": "Run the sample calculation with evaluated parameters. Its returned value is not yet committed.",
      "source": {
        "path": "domain.py",
        "symbol": "run_solver"
      },
      "capture": {
        "in": {
          "cells": "number",
          "steps": "number",
          "priority": "string",
          "param_version": "number"
        },
        "out": {
          "value": "number",
          "iterations": "number"
        }
      },
      "requirements": [
        "R1"
      ]
    },
    {
      "id": "commit",
      "kind": "effect",
      "label": "Recheck and commit artifact",
      "summary": "Reevaluate approvals and parameter version inside the transaction and commit idempotently. Emit commit after transaction success.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.commit_result"
      },
      "capture": {
        "in": {
          "computed_version": "number",
          "value": "number",
          "units": "number"
        },
        "out": {
          "effect_id": "string",
          "tx_id": "string",
          "state": "string",
          "support_ids": [
            "string"
          ],
          "param_version": "number",
          "value": "number",
          "outcome": "string"
        }
      },
      "requirements": [
        "R3",
        "R5"
      ]
    },
    {
      "id": "barrier",
      "kind": "decision",
      "label": "Computation version barrier",
      "summary": "Prevent committing a computation after its parameters change.",
      "source": {
        "path": "domain.py",
        "symbol": "same_version"
      },
      "capture": {
        "in": {
          "computed_version": "number",
          "current_version": "number"
        },
        "out": {
          "allowed": "boolean"
        }
      },
      "parent": "commit",
      "requirements": [
        "R5"
      ],
      "predicate": "computed_version == current_version"
    },
    {
      "id": "change",
      "kind": "action",
      "label": "Parameter / relation changes",
      "summary": "Business commands change fact versions and invalidate old decisions. The graph does not execute commands.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.change"
      },
      "capture": {
        "in": {
          "command": "string"
        },
        "out": {
          "epoch": "number",
          "param_version": "number",
          "clock": "number"
        }
      },
      "requirements": [
        "R6"
      ]
    },
    {
      "id": "parameters",
      "kind": "data",
      "label": "Current task parameters",
      "summary": "cells, steps, priority, and param_version.",
      "source": {
        "path": "domain.py",
        "symbol": "Lab.read_job"
      },
      "capture": {
        "in": {},
        "out": {
          "cells": "number",
          "steps": "number",
          "priority": "string",
          "param_version": "number"
        }
      }
    }
